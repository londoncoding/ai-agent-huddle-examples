{
  "name": "AI Agent Huddle CLAIM — lease demonstration (no protected write)",
  "active": false,
  "nodes": [
    {
      "id": "run-demo-manually",
      "name": "Run demo manually",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "configure-demo",
      "name": "Configure demo",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "resource",
              "name": "resource",
              "value": "demo/n8n-claim",
              "type": "string"
            },
            {
              "id": "acquireRequestId",
              "name": "acquireRequestId",
              "value": "REPLACE_WITH_NEW_ACQUIRE_UUID",
              "type": "string"
            },
            {
              "id": "releaseRequestId",
              "name": "releaseRequestId",
              "value": "REPLACE_WITH_NEW_RELEASE_UUID",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "acquire-claim-lease",
      "name": "Acquire CLAIM lease",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://claim.aiagenthuddle.com/v1/leases",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ resource: $json.resource, agent_id: \"n8n-demo-worker\", ttl_seconds: 60, request_id: $json.acquireRequestId }) }}",
        "options": {
          "timeout": 20000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "retryOnFail": false,
      "onError": "stopWorkflow"
    },
    {
      "id": "valid-granted-result",
      "name": "Valid GRANTED result",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        700,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "Valid GRANTED result",
              "leftValue": "={{ $json.statusCode >= 200 && $json.statusCode < 300 && $json.body?.status === \"GRANTED\" && /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test($json.body.lease_id ?? \"\") && typeof $json.body.fencing_token === \"string\" && /^[1-9][0-9]*$/.test($json.body.fencing_token) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "demo-only-—-no-protected-write",
      "name": "Demo only — no protected write",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        920,
        -100
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "message",
              "name": "message",
              "value": "GRANTED. This node performs no external or protected write. Storage must enforce fencing atomically.",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "release-known-lease",
      "name": "Release known lease",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1160,
        -100
      ],
      "parameters": {
        "method": "DELETE",
        "url": "={{ \"https://claim.aiagenthuddle.com/v1/leases/\" + encodeURIComponent($(\"Acquire CLAIM lease\").first().json.body.lease_id) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ request_id: $(\"Configure demo\").first().json.releaseRequestId }) }}",
        "options": {
          "timeout": 20000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "retryOnFail": false,
      "onError": "stopWorkflow"
    },
    {
      "id": "release-confirmed",
      "name": "Release confirmed",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1380,
        -100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "Release confirmed",
              "leftValue": "={{ $json.statusCode >= 200 && $json.statusCode < 300 && [\"RELEASED\", \"NOT_ACTIVE\"].includes($json.body?.status) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "demo-finished",
      "name": "Demo finished",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1600,
        -180
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "result",
              "name": "result",
              "value": "Known grant cleanup confirmed. No protected write was performed.",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "release-uncertain-—-stop",
      "name": "Release uncertain — stop",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        1600,
        0
      ],
      "parameters": {
        "errorMessage": "Release outcome is unconfirmed. Stop work; do not automatically retry. Lease expires 60 seconds after acquisition. Keep the original release request ID for recovery."
      }
    },
    {
      "id": "expected-denied-result",
      "name": "Expected DENIED result",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        920,
        180
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "Expected DENIED result",
              "leftValue": "={{ $json.statusCode === 409 && $json.body?.status === \"DENIED\" }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "denied-—-no-work",
      "name": "DENIED — no work",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1160,
        120
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "result",
              "name": "result",
              "value": "DENIED. No grant, demo work or release attempted.",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "acquire-uncertain-—-stop",
      "name": "Acquire uncertain — stop",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        1160,
        300
      ],
      "parameters": {
        "errorMessage": "Acquisition was not confirmed. Do not start work or rerun as a new request. Preserve the acquire UUID. An unknown grant expires after its 60-second TTL."
      }
    },
    {
      "id": "read-this-before-running",
      "name": "Read this before running",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        120,
        -360
      ],
      "parameters": {
        "content": "## CLAIM demonstration\nConfigure the two UUIDs and a private Header Auth credential on BOTH HTTP nodes: Name Authorization, Value Bearer YOUR_CLAIM_KEY. Never paste a key into this workflow. Redirects and mutation retries are OFF. Only a validated GRANTED result reaches the demo node. It performs no protected write. Production storage must compare fencing tokens and commit atomically. Timeouts stop the workflow; unknown grants expire after 60 seconds. Rerunning with a new acquire UUID is a new request.",
        "height": 260,
        "width": 650
      }
    }
  ],
  "connections": {
    "Run demo manually": {
      "main": [
        [
          {
            "node": "Configure demo",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Configure demo": {
      "main": [
        [
          {
            "node": "Acquire CLAIM lease",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Acquire CLAIM lease": {
      "main": [
        [
          {
            "node": "Valid GRANTED result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Valid GRANTED result": {
      "main": [
        [
          {
            "node": "Demo only — no protected write",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Expected DENIED result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Demo only — no protected write": {
      "main": [
        [
          {
            "node": "Release known lease",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Release known lease": {
      "main": [
        [
          {
            "node": "Release confirmed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Release confirmed": {
      "main": [
        [
          {
            "node": "Demo finished",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Release uncertain — stop",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Expected DENIED result": {
      "main": [
        [
          {
            "node": "DENIED — no work",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Acquire uncertain — stop",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none",
    "saveManualExecutions": false
  },
  "pinData": {},
  "tags": []
}
